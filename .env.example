# ===== LLM（必填）=====
# 任选一个 OpenAI 兼容服务
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
TAVILY_API_KEY=
CHAT_MODEL=gpt-4o
EXTRACT_MODEL=gpt-4o-mini

# ===== 科大讯飞语音合成（可选）=====
# 留空则 /api/v1/tts 返回 503，页面语音按钮自动置灰，对话本身不受影响
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_TTS_VOICE=xiaoyan
XUNFEI_TTS_SPEED=70

# ===== 接口鉴权（可选）=====
# 留空则不校验；设置后所有 /api/v1/* 需要带 X-API-Key 头
# 注意：浏览器页面无法附加该头，演示时请留空
API_KEY=

# ===== 存储路径（相对项目根目录）=====
GRAPHRAG_WORKING_DIR=dickens
CHAT_LOGS_DIR=chat_logs
AUDIO_DIR=app/static/audio

# ===== 异步任务 =====
# 单轮对话总超时（秒）
TURN_TIMEOUT_SECONDS=180
# SSE 空闲心跳间隔（秒），需小于反向代理的读超时
SSE_KEEPALIVE_SECONDS=15

# ===== 任务后端 =====
TASK_BACKEND=memory          # memory | redis
EXECUTION_MODE=inline        # inline | queue（queue 需要 Redis + arq worker）
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 会话状态持久化 =====
CHECKPOINT_BACKEND=memory    # memory | sqlite | postgres
CHECKPOINT_SQLITE_PATH=checkpoints.sqlite
# postgres 后端必填，例：postgresql://postgres:postgres@127.0.0.1:5432/cmekg
DATABASE_URL=

# ===== 任务租约与并发保护 =====
# worker 崩溃后，超过租约仍处于 running 的任务会被后台回收为 failed
TASK_LEASE_SECONDS=300
REAPER_INTERVAL_SECONDS=30
# 同一会话串行：单机用 memory，多副本必须 redis
SESSION_LOCK_BACKEND=memory
SESSION_LOCK_TIMEOUT_SECONDS=30
# 限流：单机用 memory，多副本必须 redis（否则额度会被放大 N 倍）
RATE_LIMIT_BACKEND=memory

# ===== GraphRAG 分层降级 =====
# 风险告知环节最多等预取多久（秒）；每个会话只等一次，超时直接降级
GRAPHQA_WAIT_SECONDS=2
# 各层检索的超时预算（秒）：global 社区摘要 → local 实体检索 → 词面兜底
GRAPHQA_GLOBAL_TIMEOUT=20
GRAPHQA_LOCAL_TIMEOUT=8
GRAPHQA_KEYWORD_TIMEOUT=0.5

# ===== 基础设施（Docker Compose）=====
POSTGRES_USER=cmekg
POSTGRES_PASSWORD=cmekg_dev_local
POSTGRES_DB=cmekg
POSTGRES_PORT=5432
REDIS_PORT=6379
